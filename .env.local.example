# Copy to .env.local

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://oilpchbgufjtbxhpzula.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Required for OTP verify → session (Dashboard → Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Email OTP — SendGrid only by default
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.xxxxxxxx
SENDGRID_FROM_EMAIL=TRYST <you@yourverifieddomain.com>
EMAIL_FROM=TRYST <you@yourverifieddomain.com>
EMAIL_FALLBACK_RESEND=false

# Optional Resend (only if EMAIL_PROVIDER=resend or EMAIL_FALLBACK_RESEND=true)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Twilio (Voice + Video) — put REAL values only in .env.local (never commit secrets)
# Account SID + Auth Token: Console home
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# API Key SID + Secret: Console → Account → API keys & tokens → Create API key
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_key_secret
# Optional — Voice: Console → Voice → TwiML Apps → App SID (starts with AP)
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OneSignal (Web Push) — App ID is public; REST key is server-only
# Dashboard → Settings → Keys & IDs
NEXT_PUBLIC_ONESIGNAL_APP_ID=804274d9-0ff1-428f-a5f7-ae89a23853c6
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key
